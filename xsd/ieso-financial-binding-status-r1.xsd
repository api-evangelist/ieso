<!-- Financially Binding Status XML Schema -->
<xs:schema targetNamespace="http://www.ieso.ca/schema" elementFormDefault="qualified" xmlns="http://www.ieso.ca/schema" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<!-- Following stuff is report specific -->
	<xs:include schemaLocation="Document_r1.xsd"/>
	<xs:element name="DocBody">
		<xs:annotation>
			<xs:documentation>Document Body</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="MPShortName" nillable="false">
					<xs:annotation>
						<xs:documentation>IESO Market Participant Short Name</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="12"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="JurisdictionEnergies" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Groups the Jurisdiction data and the Delivery Date</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="DeliveryDate" type="xs:date">
								<xs:annotation>
									<xs:documentation>The Date for which this data applies</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Jurisdiction" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>Groups all the Scheduled Energies data and Jurisdiction Name</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="JurisdictionName" type="xs:string" nillable="false">
											<xs:annotation>
												<xs:documentation>Name of the external jurisdiction (NYISO or MISO)</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ScheduledEnergies" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>Groups all the Physical and Virtual Energies data(where applicable) for a specific Jurisdiction Name</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="PhysicalEnergies" minOccurs="0" maxOccurs="unbounded">
														<xs:annotation>
															<xs:documentation>Physical DAM results for the external jurisdiction</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="ExportsScheduledEnergies" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Exports Scheduled from external jurisdiction into Ontario.</xs:documentation>
																	</xs:annotation>
																	<xs:complexType>
																		<xs:sequence>
																			<xs:element name="HourlyEnergy" type="HourlyValue" maxOccurs="24">
																				<xs:annotation>
																					<xs:documentation>Groups the Energy value and the DeliveryHour</xs:documentation>
																				</xs:annotation>
																			</xs:element>
																		</xs:sequence>
																	</xs:complexType>
																</xs:element>
																<xs:element name="ImportsScheduledEnergies" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Imports Scheduled into external jurisdiction from Ontario.</xs:documentation>
																	</xs:annotation>
																	<xs:complexType>
																		<xs:sequence>
																			<xs:element name="HourlyEnergy" type="HourlyValue" maxOccurs="24">
																				<xs:annotation>
																					<xs:documentation>Groups the Energy value and the DeliveryHour</xs:documentation>
																				</xs:annotation>
																			</xs:element>
																		</xs:sequence>
																	</xs:complexType>
																</xs:element>
															</xs:sequence>
														</xs:complexType>
													</xs:element>
													<xs:element name="VirtualEnergies" minOccurs="0" maxOccurs="unbounded">
														<xs:annotation>
															<xs:documentation>Virtual DAM results for the external jurisdiction</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="ExportsScheduledEnergies" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Virtual Purchases at IESO Interface</xs:documentation>
																	</xs:annotation>
																	<xs:complexType>
																		<xs:sequence>
																			<xs:element name="HourlyEnergy" type="HourlyValue" maxOccurs="24">
																				<xs:annotation>
																					<xs:documentation>Groups the Energy value and the DeliveryHour</xs:documentation>
																				</xs:annotation>
																			</xs:element>
																		</xs:sequence>
																	</xs:complexType>
																</xs:element>
																<xs:element name="ImportsScheduledEnergies" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Virtual Sales at IESO Interface</xs:documentation>
																	</xs:annotation>
																	<xs:complexType>
																		<xs:sequence>
																			<xs:element name="HourlyEnergy" type="HourlyValue" maxOccurs="24">
																				<xs:annotation>
																					<xs:documentation>Groups the Energy value and the DeliveryHour</xs:documentation>
																				</xs:annotation>
																			</xs:element>
																		</xs:sequence>
																	</xs:complexType>
																</xs:element>
															</xs:sequence>
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- Hourly Value combined Delivery Hour and Energy Value-->
	<xs:complexType name="HourlyValue">
		<xs:sequence>
			<xs:element name="DeliveryHour" type="Hour1To24">
				<xs:annotation>
					<xs:documentation>The Hour for which this data applies (1 to 24)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- Energy MW -->
			<xs:element name="EnergyMW" type="MW_decimal5.1">
				<xs:annotation>
					<xs:documentation>The amount of Energy for this hour</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Decimal MW-->
	<xs:simpleType name="MW_decimal5.1">
		<xs:annotation>
			<xs:documentation>The amount of Energy MW in deciaml</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="6"/>
			<xs:fractionDigits value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Delivery hour indicates hour ending at (1 to 24)-->
	<xs:simpleType name="Hour1To24">
		<xs:annotation>
			<xs:documentation>The Hour for which this data applies (1 to 24)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="24"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
