  </wsdl:message>

  <wsdl:message name="SubmissionPartiallyRejectedFault">
    <wsdl:documentation>output Bid upload messages for partially rejected submissions.</wsdl:documentation>
    <wsdl:part element="emimd:BidProcessingStatus" name="response"/>
  </wsdl:message>

  <wsdl:message name="SubmissionFullyRejectedFault">
    <wsdl:documentation>output Bid upload message for fully rejected submissions.</wsdl:documentation>
    <wsdl:part element="emimd:BidProcessingStatus" name="response"/>
  </wsdl:message>

  <wsdl:message name="QueryFault">
    <wsdl:documentation>output message for query failures.</wsdl:documentation>
    <wsdl:part element="emimd:QueryFault" name="response"/>
  </wsdl:message>

