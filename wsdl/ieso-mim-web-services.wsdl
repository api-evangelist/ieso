<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:emimd="http://webservices.ieso.ca/emim-types/"
  xmlns:tns="http://webservices.ieso.ca/emim/"
  name="emim-web-service"
  targetNamespace="http://webservices.ieso.ca/emim/">

  <wsdl:documentation>
    MIM WSDL - Describes IESO MIM Web Service

    Version: 2.0

    History:
    2.0 14-NOV-2022 Initial

    This WSDL defines the operations provided the IESO MIM Web Service.

    The service can be broken down into the following categories

    - Market Status retrieval
    - Market Message retrieval
    - Resource retrieval
    - Forebay retrieval
    - Bid Query/retrieval
    - Bid Cancel
    - Bid Upload
    - Act-As Market Participant list retrieval
    - Web Service Health/Status retrieval

    Descriptions of the schema types used within are described in the imported emim.xsd file.

    Uses the input-output/request-response Web Service MEP pattern exclusively.

    The following defines all the messages used by operations. 
    For each operation, a separate 'input' and 'output' message is defined.
    The use of 'input' and 'output' pertains to the service view; it receives
    'input' messages and responds with 'output' messages.

  </wsdl:documentation>

  <wsdl:types>
    <wsdl:documentation>all schema types used by this service are define in emim.xsd</wsdl:documentation>
    <xsd:schema targetNamespace="http://webservices.ieso.ca/emim/">
      <xsd:import namespace="http://webservices.ieso.ca/emim-types/" schemaLocation="emim.xsd"/>
    </xsd:schema>
  </wsdl:types>

  <!-- The following defines the messages used by the Market Status retrieval operation. -->

  <wsdl:message name="MarketStatusRequest">
    <wsdl:documentation>input Market Status retrieval message</wsdl:documentation>
    <wsdl:part element="emimd:MarketStatusQuery" name="request"/>
  </wsdl:message>

  <wsdl:message name="MarketStatusResponse">
    <wsdl:documentation>output Market Statue retrieval message</wsdl:documentation>
    <wsdl:part element="emimd:MarketStatus" name="response"/>
  </wsdl:message>

