  <wsdl:message name="RealtimeEnergyBidUploadRequest">
    <wsdl:documentation>input Realtime Energy Bid upload message</wsdl:documentation>
    <wsdl:part element="emimd:RealtimeEnergyBidSubmit" name="request"/>
  </wsdl:message>

  <wsdl:message name="ScheduleBidUploadRequest">
    <wsdl:documentation>input Schedule Bid upload message</wsdl:documentation>
    <wsdl:part element="emimd:ScheduleBidSubmit" name="request"/>
