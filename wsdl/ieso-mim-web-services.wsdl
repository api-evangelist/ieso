  <wsdl:message name="MarketMessageResponse">
    <wsdl:documentation>output Market Message retrieval message</wsdl:documentation>
    <wsdl:part element="emimd:MarketMessageSet" name="response"/>
  </wsdl:message>

  <!-- The following defines the messages used by the Resource retrieval operation. -->

  <wsdl:message name="ResourceRequest">
